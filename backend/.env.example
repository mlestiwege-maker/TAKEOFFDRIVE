ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://takeoff:takeoff@localhost:5432/takeoff_onboarding

JWT_SECRET_KEY=change-me-in-production-this-is-a-dev-only-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_DEBUG_ECHO=true

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Optional: switch document storage from local disk to S3 (or an
# S3-compatible / GCS-interop endpoint via S3_ENDPOINT_URL). Leave
# S3_BUCKET_NAME unset to keep using local disk.
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read by boto3 directly from
# the environment if you set S3_BUCKET_NAME above.

CORS_ORIGINS=["http://localhost:5173"]

FIRST_ADMIN_EMAIL=admin@takeoff.dev
FIRST_ADMIN_PASSWORD=AdminPass123!

RATE_LIMIT_ENABLED=true
# Optional: share rate-limit counters across multiple backend instances.
# Leave unset to use in-memory storage (fine for a single instance).
REDIS_URL=

# Optional: real SMS delivery via Twilio. Leave unset to keep OTP codes
# console-logged only (paired with OTP_DEBUG_ECHO for local/demo use).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: real email delivery via SMTP (SendGrid, Mailgun, SES, Gmail app
# password, etc). Leave unset to keep notification emails console-logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
